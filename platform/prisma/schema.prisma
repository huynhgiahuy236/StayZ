generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id         String    @id @default(uuid()) @db.VarChar(64)
  full_name  String    @db.VarChar(100)
  email      String    @unique(map: "email") @db.VarChar(150)
  password   String?   @db.VarChar(255)
  phone      String?   @db.VarChar(20)
  role       String?   @default("customer") @db.VarChar(20)
  avatar_url String?   @db.Text
  google_id  String?   @db.VarChar(100)
  created_at DateTime? @default(now()) @db.DateTime(0)
  updated_at DateTime? @default(now()) @updatedAt @db.DateTime(0)
  bookings   Booking[]
  reviews    Review[]

  @@map("users")
}

model Booking {
  id           String    @id @default(uuid()) @db.VarChar(64)
  booking_code String    @unique(map: "booking_code") @db.VarChar(30)
  user_id      String    @db.VarChar(64)
  property_id  String    @db.VarChar(64)
  room_id      String    @db.VarChar(64)
  check_in     DateTime  @db.Date
  check_out    DateTime  @db.Date
  guest_count  Int?      @default(1)
  total_price  Decimal   @db.Decimal(15, 2)
  status       String?   @default("pending") @db.VarChar(20)
  created_at   DateTime? @default(now()) @db.DateTime(0)
  user         User      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "bookings_ibfk_1")
  payments     Payment[]

  @@index([user_id], map: "user_id")
  @@map("bookings")
}

model Payment {
  id               String    @id @default(uuid()) @db.VarChar(64)
  booking_id       String    @db.VarChar(64)
  amount           Decimal   @db.Decimal(15, 2)
  payment_method   String?   @default("payos") @db.VarChar(30)
  payos_order_code BigInt?   @unique(map: "payos_order_code")
  status           String?   @default("PENDING") @db.VarChar(20)
  paid_at          DateTime? @db.DateTime(0)
  created_at       DateTime? @default(now()) @db.DateTime(0)
  booking          Booking   @relation(fields: [booking_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "payments_ibfk_1")

  @@index([booking_id], map: "booking_id")
  @@map("payments")
}

model Review {
  id          String    @id @default(uuid()) @db.VarChar(64)
  user_id     String    @db.VarChar(64)
  property_id String    @db.VarChar(64)
  rating      Int
  comment     String?   @db.Text
  created_at  DateTime? @default(now()) @db.DateTime(0)
  user        User      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "reviews_ibfk_1")

  @@index([user_id], map: "user_id")
  @@map("reviews")
}

model Coupon {
  id               String    @id @default(uuid()) @db.VarChar(64)
  code             String    @unique(map: "code") @db.VarChar(30)
  discount_percent Int
  max_discount     Decimal?  @default(0.00) @db.Decimal(15, 2)
  valid_until      DateTime? @db.DateTime(0)
  created_at       DateTime? @default(now()) @db.DateTime(0)

  @@map("coupons")
}
